    function buildMask(W, H, px, cols, rows) {
      const cv = document.createElement('canvas'); cv.width = cols; cv.height = rows;
      const g = cv.getContext('2d', { willReadFrequently: true });
      const thr = getThreshold(), inv = $('preview-invert').checked;
      g.fillStyle = inv ? '#000' : '#fff'; g.fillRect(0, 0, cols, rows);
      const crop = getContentCropBox(loadedImage);
      const dims = getTargetDimensionsMM(crop, W, H);
      const drawWpx = dims.wMM / px, drawHpx = dims.hMM / px;
      g.translate((W / 2 + (Number(previewX.value) || 0)) / px, (H / 2 - (Number(previewY.value) || 0)) / px);
      g.rotate((Number(previewRotation.value) || 0) * Math.PI / 180);
      g.imageSmoothingQuality = 'high';
      g.drawImage(loadedImage, crop.sx, crop.sy, crop.sw, crop.sh, -drawWpx / 2, -drawHpx / 2, drawWpx, drawHpx);
      const d = g.getImageData(0, 0, cols, rows).data, m = new Uint8Array(cols * rows);
      for (let i = 0; i < m.length; i++) {
        const lum = (d[i * 4] + d[i * 4 + 1] + d[i * 4 + 2]) / 3;
        m[i] = (inv ? lum > thr : lum < thr) ? 1 : 0;
      }
      return { mask: m, dims };
    }

    function generateTapFromImage() {
      if (!loadedImage) return;
      const v = validateDepths(), errs = v.errs.slice();
      const W = parseFloat(paramWidth.value), H = parseFloat(paramHeight.value), safeZ = parseFloat(paramSafeZ.value),
            feed = parseFloat(paramFeed.value), step = parseFloat(paramStep.value), D = parseFloat(paramTool.value);
      if (!(W > 0 && H > 0)) errs.push('Размер заготовки X и Y должен быть больше 0.');
      if (!(D > 0)) errs.push('Диаметр фрезы должен быть больше 0.');
      if (!(safeZ > 0)) errs.push('Безопасная Z должна быть больше 0.');
      if (!(feed > 0)) errs.push('Рабочая подача F должна быть больше 0.');
      if (!(step > 0)) errs.push('Шаг растра должен быть больше 0.');
      if (errs.length) { failGen(errs); return; }
      setLog(['⏳ Генерация 3D рельефа и расчёт траектории…'], 'warn');
      setTimeout(() => { try { runCam({ W, H, safeZ, feed, step, D, z: v.z }); } catch (e) { failGen([e.message]); } }, 20);
    }

    let warnPaths = [];

    // ===================== ГЛАВНЫЙ ДВИЖОК 3D + 2.5D CAM =====================
    function runCam(o) {
      const { W, H, safeZ, feed, step, D, z } = o;
      const R = D / 2;
      const mode = paramMode.value;
      const toolType = $('param-tool-type').value;
      const vAngle = parseFloat($('param-vangle').value) || 30;
      const maxDepthAbs = Math.abs(parseFloat(paramCutZ.value) || 6);
      const org = getOrigin(), ox = org.fx * W, oy = org.fy * H;
      const sep = chkTabs.checked ? '\t' : ' ';
      const plungeIn = parseFloat($('param-plunge').value);
      const plunge = plungeIn > 0 ? plungeIn : Math.min(400, feed);
      const num3 = (q) => { const v = Math.round(q * 1000) / 1000; return Object.is(v, -0) ? 0 : v; };
      const f3 = (q) => num3(q).toFixed(3);
      const fx = (q) => num3(q - ox), fy = (q) => num3(q - oy);
      const lines = [], kinds = [], L = (s, k) => { lines.push(s); kinds.push(k || ''); };

      // Всегда строим 3D карту высот для визуализации рельефа в 3D-окне
      let rPx = Math.min(Math.max(step * 0.5, 0.25), 0.8);
      while ((W / rPx) * (H / rPx) > 4.5e5) rPx *= 1.15;
      const rCols = Math.max(10, Math.ceil(W / rPx));
      const rRows = Math.max(10, Math.ceil(H / rPx));
      const hMap = buildHeightMap(W, H, rPx, rCols, rRows, maxDepthAbs);
      lastHeightField = { grid: hMap.zGrid, cols: rCols, rows: rRows, W, H, ox, oy, maxDepth: maxDepthAbs };

      if ($('chk-header').checked) { ['G21', 'G17', 'G40', 'G49', 'G54'].forEach(c => L(c)); }
      const spindle = parseFloat($('param-spindle').value);
      L('G90');
      L('G0' + sep + 'Z' + f3(safeZ));
      L('M3' + (spindle > 0 ? sep + 'S' + Math.round(spindle) : ''));

      // --- РЕЖИМ 3D РЕЛЬЕФА (РАСТР X / РАСТР Y / ЧЕРНОВОЙ + ЧИСТОВОЙ) ---
      if (mode === 'relief_x' || mode === 'relief_y' || mode === 'relief_rough_fin') {
        const crop = getContentCropBox(loadedImage);
        const dims = getTargetDimensionsMM(crop, W, H);
        const cxObj = W / 2 + (Number(previewX.value) || 0);
        const cyObj = H / 2 + (Number(previewY.value) || 0);
        const margin = R + 1;
        const xMin = Math.max(R, cxObj - dims.wMM / 2 - margin);
        const xMax = Math.min(W - R, cxObj + dims.wMM / 2 + margin);
        const yMin = Math.max(R, cyObj - dims.hMM / 2 - margin);
        const yMax = Math.min(H - R, cyObj + dims.hMM / 2 + margin);

        if (xMax <= xMin || yMax <= yMin) throw new Error('Область 3D-обработки пуста или выходит за пределы стола.');

        const resAlong = Math.max(0.15, parseFloat($('param-res-x').value) || 0.5);
        const skipTop = $('chk-skip-top').checked;
        const allowance = mode === 'relief_rough_fin' ? Math.max(0, parseFloat($('param-allowance').value) || 0.5) : 0;

        // 1. Черновые слои по Z (если выбран режим Черновой + Чистовой)
        if (mode === 'relief_rough_fin') {
          const roughStep = Math.max(step * 2, D * 0.45);
          const roughRes = Math.max(resAlong * 2, D * 0.35);
          const roughLayers = z.slice(0, -1); // все слои кроме финального
          if (!roughLayers.length) roughLayers.push(r3(-maxDepthAbs * 0.5));

          roughLayers.forEach(zLayer => {
            const ny = Math.max(1, Math.ceil((yMax - yMin) / roughStep));
            const dy = (yMax - yMin) / ny;
            let flip = false;
            for (let j = 0; j <= ny; j++) {
              const y = yMin + j * dy;
              const nx = Math.max(2, Math.ceil((xMax - xMin) / roughRes));
              const dx = (xMax - xMin) / nx;
              let cutting = false;
              for (let i = 0; i <= nx; i++) {
                const idx = flip ? (nx - i) : i;
                const x = xMin + idx * dx;
                const surfZ = sampleToolZ(hMap.zGrid, rCols, rRows, rPx, H, x, y, R, toolType, vAngle, maxDepthAbs);
                const targetZ = Math.max(zLayer, surfZ + allowance);
                const needCut = targetZ < -0.02;
                if (needCut) {
                  if (!cutting) {
                    L('G0' + sep + 'X' + f3(fx(x)) + sep + 'Y' + f3(fy(y)));
                    L('G1' + sep + 'Z' + f3(targetZ) + sep + 'F' + plunge, 'in');
                    cutting = true;
                  } else {
                    L('G1' + sep + 'X' + f3(fx(x)) + sep + 'Y' + f3(fy(y)) + sep + 'Z' + f3(targetZ) + sep + 'F' + feed, 'in');
                  }
                } else if (cutting) {
                  L('G0' + sep + 'Z' + f3(safeZ));
                  cutting = false;
                }
              }
              if (cutting) L('G0' + sep + 'Z' + f3(safeZ));
              flip = !flip;
            }
          });
        }

        // 2. Чистовой 3D проход по поверхности рельефа (вдоль X или вдоль Y)
        const scanAlongX = mode !== 'relief_y';
        const outerMin = scanAlongX ? yMin : xMin;
        const outerMax = scanAlongX ? yMax : xMax;
        const innerMin = scanAlongX ? xMin : yMin;
        const innerMax = scanAlongX ? xMax : yMax;
        const nLines = Math.max(1, Math.ceil((outerMax - outerMin) / step));
        const dOuter = (outerMax - outerMin) / nLines;
        const nPts = Math.max(2, Math.ceil((innerMax - innerMin) / resAlong));
        const dInner = (innerMax - innerMin) / nPts;

        let flip = false;
        let inCut = false;
        let lastZ = safeZ;

        for (let row = 0; row <= nLines; row++) {
          const uOuter = outerMin + row * dOuter;
          const rowPts = [];
          for (let col = 0; col <= nPts; col++) {
            const idx = flip ? (nPts - col) : col;
            const uInner = innerMin + idx * dInner;
            const x = scanAlongX ? uInner : uOuter;
            const y = scanAlongX ? uOuter : uInner;
            const tz = sampleToolZ(hMap.zGrid, rCols, rRows, rPx, H, x, y, R, toolType, vAngle, maxDepthAbs);
            rowPts.push({ x, y, z: tz });
          }

          // Оптимизация точек (убираем лишние коллинеарные точки на плоских участках для компактности .TAP)
          const simplified = [rowPts[0]];
          for (let k = 1; k < rowPts.length - 1; k++) {
            const prev = simplified[simplified.length - 1];
            const curr = rowPts[k];
            const next = rowPts[k + 1];
            const dz1 = curr.z - prev.z, dz2 = next.z - curr.z;
            if (Math.abs(dz1) < 0.003 && Math.abs(dz2) < 0.003) continue;
            simplified.push(curr);
          }
          simplified.push(rowPts[rowPts.length - 1]);

          for (let k = 0; k < simplified.length; k++) {
            const pt = simplified[k];
            const isFlatZero = skipTop && pt.z > -0.015;
            if (isFlatZero) {
              if (inCut) {
                L('G0' + sep + 'Z' + f3(safeZ));
                inCut = false;
              }
              continue;
            }
            if (!inCut) {
              L('G0' + sep + 'X' + f3(fx(pt.x)) + sep + 'Y' + f3(fy(pt.y)));
              L('G1' + sep + 'Z' + f3(pt.z) + sep + 'F' + plunge, 'out');
              inCut = true;
              lastZ = pt.z;
            } else {
              const zPart = Math.abs(pt.z - lastZ) >= 0.001 ? sep + 'Z' + f3(pt.z) : '';
              L('G1' + sep + 'X' + f3(fx(pt.x)) + sep + 'Y' + f3(fy(pt.y)) + zPart + sep + 'F' + feed, 'out');
              lastZ = pt.z;
            }
          }
          flip = !flip;
        }
        if (inCut) L('G0' + sep + 'Z' + f3(safeZ));

      } else {
        // --- 2.5D РЕЖИМЫ (ВЫВЕСКА С ВЫБОРКОЙ ФОНА, БУКВЫ, ОРНАМЕНТ, КОНТУРЫ, КАРМАН) ---
        warnPaths = [];
        let px = Math.min(Math.max(step * 0.25, 0.12), 0.35);
        while ((W / px) * (H / px) > 2.0e6) px *= 1.15;
        const cols = Math.ceil(W / px), rows = Math.ceil(H / px);
        const built = buildMask(W, H, px, cols, rows);
        const dark = built.mask;
        if (!dark.some(q => q)) throw new Error('На изображении не найдено объектов. Проверьте порог яркости или инверсию.');

        const smoothLvl = parseInt(smoothSlider.value) || 0;
        const useDogbone = $('chk-dogbone') && $('chk-dogbone').checked;
        const stock = { x0: 0, y0: 0, x1: W, y1: H }, box = { x0: R, y0: R, x1: W - R, y1: H - R };
        let strokes = [];
        const clipAdd = (pts, b, kind = 'out', depth = 0) => {
          let p = useDogbone && (mode === 'linein' || mode === 'pocket' || kind === 'in') ? applyDogbones(pts, R) : pts;
          clipPoly(p, b).res.forEach(seg => strokes.push({ pts: seg, kind, depth }));
        };
        const tol = 0.025;

        if (mode === 'sign_emboss') {
          // Вывеска как на фото: выборка фона вокруг букв + чистовой проход по контуру букв
          const sf = signedField(dark, cols, rows, px);
          const crop = getContentCropBox(loadedImage);
          const dims = getTargetDimensionsMM(crop, W, H);
          const cxObj = W / 2 + (Number(previewX.value) || 0);
          const cyObj = H / 2 + (Number(previewY.value) || 0);
          const pad = D * 1.5;
          const signBox = {
            x0: Math.max(R, cxObj - dims.wMM / 2 - pad),
            y0: Math.max(R, cyObj - dims.hMM / 2 - pad),
            x1: Math.min(W - R, cxObj + dims.wMM / 2 + pad),
            y1: Math.min(H - R, cyObj + dims.hMM / 2 + pad)
          };
          const sp = Math.min(step, D * 0.85);
          fillRows(sf.c, cols, rows, px, H, false, R, signBox, sp).forEach(s => strokes.push({ pts: s.pts, kind: 'in', depth: 1 }));
          contourLines(sf.c, cols, rows, px, H, R).forEach(p => {
            let pts = rdp(p.pts, tol);
            if (smoothLvl > 0 && pts.length > 4) {
              const q = p.closed ? pts.slice(0, -1) : pts;
              const sm = ultraSmoothCurve(resampleLine(q, 0.3), Math.min(4, smoothLvl), p.closed);
              if (p.closed && sm.length) sm.push(sm[0].slice());
              pts = sm;
            }
            clipAdd(pts, signBox, 'out', 0);
          });
        } else if (mode === 'center') {
          skeletonPaths(dark, cols, rows, px, H, smoothLvl > 0).forEach(p => {
            const n = p.length, closed = n > 3 && Math.hypot(p[0][0] - p[n - 1][0], p[0][1] - p[n - 1][1]) < px * 1.5;
            let q = closed ? p.slice(0, -1) : p;
            if (smoothLvl > 0) { q = ultraSmoothCurve(resampleLine(q, Math.max(px * 0.8, 0.25)), smoothLvl, closed); if (closed) q.push(q[0].slice()); }
            clipAdd(q, stock);
          });
        } else if (mode === 'ornament') {
          const eff = Math.max(4, smoothLvl);
          skeletonPaths(dark, cols, rows, px, H, true).forEach(p => {
            const n = p.length, closed = n > 3 && Math.hypot(p[0][0] - p[n - 1][0], p[0][1] - p[n - 1][1]) < px * 1.5;
            let q = closed ? p.slice(0, -1) : p;
            q = ultraSmoothCurve(resampleLine(q, Math.max(px * 0.7, 0.2)), eff, closed);
            if (closed) q.push(q[0].slice());
            clipAdd(q, stock);
          });
        } else if (mode === 'letters') {
          const sf = signedField(dark, cols, rows, px);
          const cs = contourLines(sf.c, cols, rows, px, H, R).map(p => {
            let pts = rdp(p.pts, tol);
            if (smoothLvl > 0 && pts.length > 4) {
              const q = p.closed ? pts.slice(0, -1) : pts;
              const sm = ultraSmoothCurve(resampleLine(q, 0.3), Math.min(4, smoothLvl), p.closed);
              if (p.closed && sm.length) sm.push(sm[0].slice());
              pts = sm;
            }
            return { pts, closed: p.closed };
          }).filter(p => p.pts.length >= 3);
          const inPoly = (pt, poly) => { let ins = false; for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) { const a = poly[i], b = poly[j]; if ((a[1] > pt[1]) !== (b[1] > pt[1]) && pt[0] < (b[0] - a[0]) * (pt[1] - a[1]) / (b[1] - a[1]) + a[0]) ins = !ins; } return ins; };
          cs.forEach((c1, i) => {
            let depth = 0;
            if (c1.closed) cs.forEach((c2, j) => { if (i !== j && c2.closed && inPoly(c1.pts[0], c2.pts)) depth++; });
            clipAdd(c1.pts, stock, depth % 2 ? 'in' : 'out', depth);
          });
        } else {
          const F = chkFill.checked ? fillHoles(dark, cols, rows) : dark;
          const sf = signedField(F, cols, rows, px), tc = thinComps(F, sf.din, cols, rows, D, px);
          if (mode === 'pocket' || mode === 'clear') {
            const pocket = mode === 'pocket', Lval = pocket ? -R : R, c = sf.c, sp = Math.min(step, D);
            fillRows(c, cols, rows, px, H, pocket, R, box, sp).forEach(s => strokes.push({ pts: s.pts, kind: pocket ? 'in' : 'out' }));
            contourLines(c, cols, rows, px, H, Lval).forEach(p => clipAdd(rdp(p.pts, tol), box, pocket ? 'in' : 'out'));
          } else {
            let c = sf.c;
            if (tc.thinCount) {
              c = signedField(tc.thick, cols, rows, px).c;
              if (paramOpen.value === 'center') skeletonPaths(tc.thin, cols, rows, px, H).forEach(p => clipAdd(p, stock));
            }
            const Lval = mode === 'lineout' ? R : -R;
            contourLines(c, cols, rows, px, H, Lval).forEach(p => clipAdd(rdp(p.pts, tol), box, mode === 'linein' ? 'in' : 'out'));
          }
        }

        strokes = strokes.map(s => ({ ...s, pts: s.pts.filter((p, i) => i === 0 || Math.hypot(p[0] - s.pts[i - 1][0], p[1] - s.pts[i - 1][1]) > 0.004) })).filter(s => s.pts.length >= 2);
        if (!strokes.length) throw new Error('Траектория пуста для выбранных параметров.');

        const arcsOn = !!($('chk-arcs') && $('chk-arcs').checked);
        let mpos = [ox, oy];
        function emitArcOrLine(x0, y0, toPt, cxAbs, cyAbs, ccw, kind, feedSuffix) {
          const sx0 = fx(x0), sy0 = fy(y0), ex1 = fx(toPt[0]), ey1 = fy(toPt[1]);
          const ii = num3(cxAbs - x0), jj = num3(cyAbs - y0);
          const rStart = Math.hypot(ii, jj), rEndActual = Math.hypot(ex1 - (sx0 + ii), ey1 - (sy0 + jj));
          const chord = Math.hypot(ex1 - sx0, ey1 - sy0);
          if (rStart >= ARC_RMIN && rStart <= ARC_RMAX && chord >= 0.25 && Math.abs(rStart - rEndActual) <= 0.0025) {
            L((ccw ? 'G3' : 'G2') + sep + 'X' + f3(ex1) + sep + 'Y' + f3(ey1) + sep + 'I' + f3(ii) + sep + 'J' + f3(jj) + feedSuffix, kind);
            return [ex1 + ox, ey1 + oy];
          }
          L('G1' + sep + 'X' + f3(ex1) + sep + 'Y' + f3(ey1) + feedSuffix, kind);
          return [ex1 + ox, ey1 + oy];
        }
        const cutPath = (pts, kind, feedFirst) => {
          let fp = feedFirst;
          const fe = () => { const r = fp ? sep + 'F' + feed : ''; fp = false; return r; };
          if (arcsOn) {
            arcSegs(pts).forEach(sg => {
              if (sg.a) mpos = emitArcOrLine(mpos[0], mpos[1], sg.to, sg.cx, sg.cy, sg.ccw, kind, fe());
              else { L('G1' + sep + 'X' + f3(fx(sg.to[0])) + sep + 'Y' + f3(fy(sg.to[1])) + fe(), kind); mpos = sg.to; }
            });
          } else {
            pts.slice(1).forEach(p => { L('G1' + sep + 'X' + f3(fx(p[0])) + sep + 'Y' + f3(fy(p[1])) + fe(), kind); mpos = p; });
          }
        };

        z.forEach(zk => {
          const list = planStrokes(strokes, mpos, mode === 'letters');
          list.forEach(q => {
            L('G0' + sep + 'X' + f3(fx(q.pts[0][0])) + sep + 'Y' + f3(fy(q.pts[0][1])));
            mpos = q.pts[0];
            L('G1' + sep + 'Z' + f3(zk) + sep + 'F' + plunge);
            cutPath(q.pts, q.kind, true);
            L('G0' + sep + 'Z' + f3(safeZ));
          });
        });
      }

      if ($('chk-m5').checked) L('M5');
      if ($('chk-return-zero') && $('chk-return-zero').checked) {
        L('G0' + sep + 'Z' + f3(safeZ));
        L('G0' + sep + 'X0.000' + sep + 'Y0.000');
      }
      if (chkM30.checked) L('M30');

      if (lines.some(l => /NaN|undefined|Infinity/.test(l))) throw new Error('Внутренняя ошибка координат (NaN).');
      finalizeOutput(lines, kinds, { ox, oy });
      setLog(['✓ Готово! Режим: ' + (MODE_NAMES[mode] || mode) + ' · рез: ' + (lastEst.cut / 1000).toFixed(2) + ' м · G0: ' + (lastEst.rapidLen / 1000).toFixed(2) + ' м'], 'ok');
    }

    function generateTapFromText() {
      let raw = inputArea.value || loadedRawText || '';
      if (!raw.trim()) return;
      const sep = chkTabs.checked ? '\t' : ' ';
      const lines = [], kinds = [];
      let curZ = 0, minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
      raw.split(/\r\n|\r|\n/).forEach(l => {
        let line = l.trim().toUpperCase().replace(/\(.*?\)/g, '').replace(/;.*/g, '');
        if (!line) return;
        line = line.replace(/\s+/g, sep).replace(/([0-9.])(?=[A-Z])/g, `$1${sep}`);
        for (const m of line.matchAll(/([XYZ])\s*([-+]?\d*\.?\d+)/g)) {
          const val = parseFloat(m[2]);
          if (m[1] === 'X') { if (val < minX) minX = val; if (val > maxX) maxX = val; }
          else if (m[1] === 'Y') { if (val < minY) minY = val; if (val > maxY) maxY = val; }
          else if (m[1] === 'Z') curZ = val;
        }
        lines.push(line);
        kinds.push(curZ < -0.001 ? (Math.abs(curZ) > 2 ? 'in' : 'out') : 'out');
      });
      if (chkM30.checked && !lines.some(l => l.includes('M30') || l.includes('M02'))) { lines.push('M30'); kinds.push(''); }
      finalizeOutput(lines, kinds, { ox: 0, oy: 0 });
      if (isFinite(minX) && isFinite(maxX)) {
        setLog(['✓ УП загружена в 3D! Габариты: ' + (maxX - minX).toFixed(1) + '×' + (maxY - minY).toFixed(1) + ' мм'], 'ok');
      }
    }

    const ORIGIN_NAMES = { '0,0': 'Левый нижний (X0 Y0)', '0.5,0': 'Низ по центру', '1,0': 'Правый нижний', '0,0.5': 'Левый край центр', '0.5,0.5': 'Центр заготовки', '1,0.5': 'Правый край центр', '0,1': 'Левый верхний', '0.5,1': 'Верх по центру', '1,1': 'Правый верхний' };
    function getOrigin() {
      const r = document.querySelector('input[name="origin"]:checked'), v = r ? r.value : '0,0', [fx, fy] = v.split(',').map(Number);
      return { fx, fy, label: ORIGIN_NAMES[v] };
    }
    function updateOriginCaption() {
      const o = getOrigin(), W = parseFloat(paramWidth.value) || 0, H = parseFloat(paramHeight.value) || 0, f = (v) => Math.round(v * 100) / 100;
      $('origin-caption').innerHTML = '<span class="text-amber-400">' + o.label + '</span><br>Смещение: (' + f(o.fx * W) + '; ' + f(o.fy * H) + ') мм';
    }
    document.querySelectorAll('input[name="origin"]').forEach(r => r.addEventListener('change', () => { updateOriginCaption(); if (loadedImage) generateTapFromImage(); else renderViz(); }));
    [paramWidth, paramHeight, paramThickness].forEach(el => el.addEventListener('input', () => { updateOriginCaption(); rebuild3DScene(); }));

    function estimateJob(lines, rapid) {
      let x = 0, y = 0, z = 0, f = 0, gm = 0, arc = 0, cut = 0, minutes = 0, rapidLen = 0;
      lines.forEach(line => {
        const t = line.replace(/\(.*?\)/g, '').replace(/;.*/, '').toUpperCase();
        let nx = x, ny = y, nz = z, ii = null, jj = null;
        for (const m of t.matchAll(/([GXYZIJF])\s*([-+]?\d*\.?\d+)/g)) {
          const v = parseFloat(m[2]);
          if (m[1] === 'G') { if (v === 0) { gm = 0; arc = 0; } else if (v >= 1 && v <= 3) { gm = 1; arc = v === 1 ? 0 : v; } }
          else if (m[1] === 'X') nx = v; else if (m[1] === 'Y') ny = v; else if (m[1] === 'Z') nz = v;
          else if (m[1] === 'I') ii = v; else if (m[1] === 'J') jj = v; else f = v;
        }
        const dxy = Math.hypot(nx - x, ny - y), dz = nz - z;
        if (gm === 0) { if (dxy + Math.abs(dz) > 0) { minutes += Math.hypot(dxy, dz) / rapid; rapidLen += dxy; } }
        else if (arc && ii !== null && jj !== null) {
          const cx = x + ii, cy = y + jj, r = Math.hypot(ii, jj);
          let da = Math.atan2(ny - cy, nx - cx) - Math.atan2(y - cy, x - cx);
          if (arc === 2) { while (da >= 0) da -= 2 * Math.PI; } else { while (da <= 0) da += 2 * Math.PI; }
          const len = r * Math.abs(da); cut += len; minutes += len / (f > 0 ? f : 1000);
        } else { const d = Math.hypot(dxy, dz); if (d > 0) { cut += d; minutes += d / (f > 0 ? f : 1000); } }
        x = nx; y = ny; z = nz;
      });
      return { cut, minutes, rapidLen };
    }
    function fmtTime(m) {
      const s = Math.round(m * 60), h = Math.floor(s / 3600), mi = Math.floor((s % 3600) / 60), se = s % 60;
      return h ? h + ' ч ' + mi + ' мин' : mi ? mi + ' мин ' + se + ' с' : se + ' с';
    }
    function updateStats(lines) {
      const rapid = parseFloat($('param-rapid').value), est = estimateJob(lines, rapid > 0 ? rapid : 3000);
      statTime.textContent = '~' + fmtTime(est.minutes) + ' · рез ' + (est.cut / 1000).toFixed(2) + ' м';
      return est;
    }

    let lastEst = { cut: 0, minutes: 0, rapidLen: 0 };
    let lastGen = { kinds: null, org: { ox: 0, oy: 0 } };
    function finalizeOutput(lines, kinds, org) {
      const result = lines.join('\r\n');
      outputArea.value = result;
      statLines.textContent = `Кадров: ${lines.length}`;
      statSize.textContent = `${(new Blob([result]).size / 1024).toFixed(1)} KB`;
      lastEst = updateStats(lines);
      lastGen = { kinds: kinds || null, org: org || { ox: 0, oy: 0 } };
      drawVisualizer(lines, lastGen.kinds, lastGen.org, false);
      rebuild3DScene();
      voiceSay('3D траектория рассчитана, кадров: ' + lines.length);
    }

    // ===================== THREE.JS 3D ПРОСМОТРЩИК =====================
    const wrap3D = $('cnc-3d-wrap');
    let scene3D, camera3D, renderer3D, worldGroup, reliefMesh, toolMesh, pathGroup;
    let camSph = { radius: 420, theta: -0.65, phi: 0.92, target: new THREE.Vector3(0, 0, 0) };

    function init3D() {
      if (typeof THREE === 'undefined') {
        canvas3dInfo.textContent = '⚠ Three.js не загрузился (проверьте интернет). Используйте 2D вид.';
        return;
      }
      scene3D = new THREE.Scene();
      scene3D.background = new THREE.Color(0x070709);

      const cw = wrap3D.clientWidth || 700, ch = wrap3D.clientHeight || 540;
      camera3D = new THREE.PerspectiveCamera(42, cw / ch, 1, 15000);

      renderer3D = new THREE.WebGLRenderer({ antialias: true });
      renderer3D.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer3D.setSize(cw, ch);
      wrap3D.insertBefore(renderer3D.domElement, wrap3D.firstChild);

      const amb = new THREE.AmbientLight(0xffffff, 0.55);
      scene3D.add(amb);
      const dir1 = new THREE.DirectionalLight(0xfff4d6, 0.9);
      dir1.position.set(250, 400, 350);
      scene3D.add(dir1);
      const dir2 = new THREE.DirectionalLight(0x60a5fa, 0.35);
      dir2.position.set(-300, 200, -250);
      scene3D.add(dir2);

      worldGroup = new THREE.Group();
      scene3D.add(worldGroup);

      // Фреза в 3D
      const toolGeo = new THREE.CylinderGeometry(1.5, 1.5, 24, 16);
      const toolMat = new THREE.MeshStandardMaterial({ color: 0xef4444, emissive: 0x7f1d1d, metalness: 0.6, roughness: 0.3 });
      toolMesh = new THREE.Mesh(toolGeo, toolMat);
      toolMesh.visible = false;
      scene3D.add(toolMesh);

      updateCamera3D();
      setup3DControls();
      rebuild3DScene();
      animate3D();
    }

    function updateCamera3D() {
      if (!camera3D) return;
      const sinPhi = Math.sin(camSph.phi);
      camera3D.position.set(
        camSph.target.x + camSph.radius * sinPhi * Math.sin(camSph.theta),
        camSph.target.y + camSph.radius * Math.cos(camSph.phi),
        camSph.target.z + camSph.radius * sinPhi * Math.cos(camSph.theta)
      );
      camera3D.lookAt(camSph.target);
    }

    function setup3DControls() {
      const dom = renderer3D.domElement;
      let dragMode = 0, prevX = 0, prevY = 0;
      dom.addEventListener('contextmenu', e => e.preventDefault());
      dom.addEventListener('pointerdown', e => {
        dom.setPointerCapture(e.pointerId);
        dragMode = e.button === 2 || e.shiftKey ? 2 : 1;
        prevX = e.clientX; prevY = e.clientY;
        dom.style.cursor = 'grabbing';
      });
      dom.addEventListener('pointermove', e => {
        if (!dragMode) return;
        const dx = e.clientX - prevX, dy = e.clientY - prevY;
        prevX = e.clientX; prevY = e.clientY;
        if (dragMode === 1) {
          camSph.theta -= dx * 0.007;
          camSph.phi = Math.max(0.05, Math.min(Math.PI * 0.49, camSph.phi - dy * 0.007));
        } else {
          const panScale = camSph.radius * 0.0014;
          const right = new THREE.Vector3(Math.cos(camSph.theta), 0, -Math.sin(camSph.theta));
          const fwd = new THREE.Vector3(-Math.sin(camSph.theta), 0, -Math.cos(camSph.theta));
          camSph.target.addScaledVector(right, -dx * panScale);
          camSph.target.addScaledVector(fwd, dy * panScale);
        }
        updateCamera3D();
      });
      const stopDrag = e => { dragMode = 0; dom.style.cursor = 'grab'; };
      dom.addEventListener('pointerup', stopDrag);
      dom.addEventListener('pointercancel', stopDrag);
      dom.addEventListener('wheel', e => {
        e.preventDefault();
        camSph.radius = Math.max(20, Math.min(4000, camSph.radius * Math.exp(e.deltaY * 0.0012)));
        updateCamera3D();
      }, { passive: false });
    }

    function resize3D() {
      if (!renderer3D || !camera3D) return;
      const cw = wrap3D.clientWidth || 700, ch = wrap3D.clientHeight || 540;
      camera3D.aspect = cw / ch;
      camera3D.updateProjectionMatrix();
      renderer3D.setSize(cw, ch);
    }

    // Преобразование координат ЧПУ (X право, Y глубь экрана, Z вверх) в Three.js (X, Y=Z_cnc, Z=-Y_cnc)
    const cncTo3D = (x, y, z) => new THREE.Vector3(x, z, -y);

    function rebuild3DScene() {
      if (!worldGroup) return;
      while (worldGroup.children.length) worldGroup.remove(worldGroup.children[0]);

      const W = parseFloat(paramWidth.value) || 300;
      const H = parseFloat(paramHeight.value) || 200;
      const T = parseFloat(paramThickness.value) || 18;
      const o = getOrigin();
      const ox = o.fx * W, oy = o.fy * H;

      // Сетка стола
      const gridSize = Math.max(W, H) * 1.6;
      const grid = new THREE.GridHelper(gridSize, 20, 0x333333, 0x181818);
      grid.position.set(W / 2 - ox, -T, -(H / 2 - oy));
      worldGroup.add(grid);

      // Основание заготовки (дерево / МДФ)
      const stockGeo = new THREE.BoxGeometry(W, T, H);
      const stockMat = new THREE.MeshStandardMaterial({
        color: 0x6b4f31,
        roughness: 0.85,
        metalness: 0.05,
        transparent: true,
        opacity: lastHeightField ? 0.32 : 0.78
      });
      const stockMesh = new THREE.Mesh(stockGeo, stockMat);
      stockMesh.position.set(W / 2 - ox, -T / 2, -(H / 2 - oy));
      worldGroup.add(stockMesh);

      // Контур заготовки
      const edges = new THREE.EdgesGeometry(stockGeo);
      const lineBox = new THREE.LineSegments(edges, new THREE.LineBasicMaterial({ color: 0xfbbf24, transparent: true, opacity: 0.5 }));
      lineBox.position.copy(stockMesh.position);
      worldGroup.add(lineBox);

      // Маркер X0 Y0 Z0
      const axLen = Math.min(W, H) * 0.18;
      const axes = new THREE.AxesHelper(Math.max(20, axLen));
      worldGroup.add(axes);

      // 3D поверхность рельефа (если загружено изображение)
      if (lastHeightField && $('chk-3d-mesh').checked) {
        const hf = lastHeightField;
        const segX = Math.min(220, hf.cols - 1);
        const segY = Math.min(220, hf.rows - 1);
        const geo = new THREE.PlaneGeometry(hf.W, hf.H, segX, segY);
        geo.rotateX(-Math.PI / 2);
        const pos = geo.attributes.position;
        const colors = new Float32Array(pos.count * 3);
        const maxD = Math.max(0.01, hf.maxDepth);

        for (let i = 0; i < pos.count; i++) {
          const lx = pos.getX(i) + hf.W / 2; // 0..W
          const lz = pos.getZ(i) + hf.H / 2; // 0..H (где 0 = верх Y=H, H = низ Y=0)
          const ci = Math.max(0, Math.min(hf.cols - 1, Math.round((lx / hf.W) * (hf.cols - 1))));
          const cj = Math.max(0, Math.min(hf.rows - 1, Math.round((lz / hf.H) * (hf.rows - 1))));
          const zVal = hf.grid[cj * hf.cols + ci];
          pos.setY(i, zVal);

          // Градиент цвета по глубине рельефа (светлое золото сверху -> тёмный орех в глубине)
          const t = Math.max(0, Math.min(1, 1 + zVal / maxD));
          colors[i * 3]     = 0.25 + 0.62 * t;
          colors[i * 3 + 1] = 0.16 + 0.48 * t;
          colors[i * 3 + 2] = 0.08 + 0.26 * t;
        }
        geo.setAttribute('color', new THREE.BufferAttribute(colors, 3));
        geo.computeVertexNormals();
        const mat = new THREE.MeshStandardMaterial({
          vertexColors: true,
          roughness: 0.62,
          metalness: 0.08,
          side: THREE.DoubleSide
        });
        reliefMesh = new THREE.Mesh(geo, mat);
        reliefMesh.position.set(hf.W / 2 - hf.ox, 0.02, -(hf.H / 2 - hf.oy));
        worldGroup.add(reliefMesh);
      }

      // 3D траектории фрезы
      if (simSegs.length > 0 && $('chk-3d-paths').checked) {
        pathGroup = new THREE.Group();
        const rapidPts = [], cutPts = [], roughPts = [];
        const limit = Math.min(simIdx, simSegs.length);
        for (let i = 0; i < limit; i++) {
          const s = simSegs[i];
          const p0 = cncTo3D(s.x0, s.y0, s.z0);
          const p1 = cncTo3D(s.x1, s.y1, s.z1);
          if (s.gm === 0) {
            rapidPts.push(p0, p1);
          } else if (s.kind === 'in') {
            roughPts.push(p0, p1);
          } else {
            cutPts.push(p0, p1);
          }
        }
        if (rapidPts.length) {
          const g0 = new THREE.BufferGeometry().setFromPoints(rapidPts);
          pathGroup.add(new THREE.LineSegments(g0, new THREE.LineBasicMaterial({ color: 0x525252, transparent: true, opacity: 0.45 })));
        }
        if (roughPts.length) {
          const gIn = new THREE.BufferGeometry().setFromPoints(roughPts);
          pathGroup.add(new THREE.LineSegments(gIn, new THREE.LineBasicMaterial({ color: 0x38bdf8 })));
        }
        if (cutPts.length) {
          const gOut = new THREE.BufferGeometry().setFromPoints(cutPts);
          pathGroup.add(new THREE.LineSegments(gOut, new THREE.LineBasicMaterial({ color: 0xfbbf24 })));
        }
        worldGroup.add(pathGroup);

        // Позиция фрезы
        const cur = simSegs[Math.max(0, limit - 1)];
        if (cur && toolMesh) {
          const D = parseFloat(paramTool.value) || 3;
          toolMesh.scale.set(D / 3, 1, D / 3);
          toolMesh.position.set(cur.x1, cur.z1 + 12, -cur.y1);
          toolMesh.visible = true;
        }
      } else if (toolMesh) {
        toolMesh.visible = false;
      }

      canvas3dInfo.textContent = `3D Заготовка: ${W}×${H}×${T} мм | Сегментов: ${simSegs.length}`;
    }

    function set3DViewPreset(preset) {
      const W = parseFloat(paramWidth.value) || 300;
      const H = parseFloat(paramHeight.value) || 200;
      const o = getOrigin();
      camSph.target.set(W / 2 - o.fx * W, 0, -(H / 2 - o.fy * H));
      const dist = Math.max(W, H) * 1.35;
      if (preset === 'top') { camSph.theta = 0; camSph.phi = 0.05; camSph.radius = dist; }
      else if (preset === 'front') { camSph.theta = 0; camSph.phi = Math.PI * 0.46; camSph.radius = dist; }
      else { camSph.theta = -0.65; camSph.phi = 0.92; camSph.radius = dist; }
      updateCamera3D();
    }
    $('btn-3d-iso').addEventListener('click', () => set3DViewPreset('iso'));
    $('btn-3d-top').addEventListener('click', () => set3DViewPreset('top'));
    $('btn-3d-front').addEventListener('click', () => set3DViewPreset('front'));
    $('chk-3d-mesh').addEventListener('change', rebuild3DScene);
    $('chk-3d-paths').addEventListener('change', rebuild3DScene);

    function animate3D() {
      requestAnimationFrame(animate3D);
      if (renderer3D && scene3D && camera3D && !$('view-3d').classList.contains('hidden')) {
        renderer3D.render(scene3D, camera3D);
      }
    }

    // ===================== 2D ВИЗУАЛИЗАТОР И СИМУЛЯЦИЯ =====================
    let viz = null, view = { z: 1, tx: 0, ty: 0 }, vp = null;
    let simSegs = [], simPlaying = false, simIdx = 0, simRaf = null;
    const canvasXY = $('canvas-xy');

    function parseViz(lines, kinds) {
      const rapid = new Path2D(), g = { out: new Path2D(), in: new Path2D(), tab: new Path2D(), warn: new Path2D() };
      let x = 0, y = 0, z = 0, f = 0, gm = 0, arc = 0, first = null;
      let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
      const segs = [];
      lines.forEach((line, idx) => {
        const tx = line.replace(/\(.*?\)/g, '').replace(/;.*/, '').toUpperCase();
        let nx = x, ny = y, nz = z, has = false, ii = null, jj = null;
        for (const m of tx.matchAll(/([GXYZIJF])\s*([-+]?\d*\.?\d+)/g)) {
          const v = parseFloat(m[2]);
          if (m[1] === 'G') { if (v === 0) { gm = 0; arc = 0; } else if (v === 1 || v === 2 || v === 3) { gm = 1; arc = v === 1 ? 0 : v; } }
          else if (m[1] === 'X') { nx = v; has = true; }
          else if (m[1] === 'Y') { ny = v; has = true; }
          else if (m[1] === 'Z') { nz = v; has = true; }
          else if (m[1] === 'I') ii = v;
          else if (m[1] === 'J') jj = v;
          else if (m[1] === 'F') f = v;
        }
        if (has) {
          const knd = (kinds && kinds[idx]) || 'out';
          const p = gm === 0 ? rapid : (g[knd] || g.out);
          const r = arc && ii !== null && jj !== null ? Math.hypot(ii, jj) : 0;
          if (nx !== x || ny !== y) {
            p.moveTo(x, y);
            if (gm === 1 && r > 0) {
              const cx = x + ii, cy = y + jj;
              p.arc(cx, cy, r, Math.atan2(y - cy, x - cx), Math.atan2(ny - cy, nx - cx), arc === 2);
            } else p.lineTo(nx, ny);
            if (gm === 1) {
              if (!first) first = [x, y];
              minX = Math.min(minX, x, nx); maxX = Math.max(maxX, x, nx);
              minY = Math.min(minY, y, ny); maxY = Math.max(maxY, y, ny);
            }
          }
          segs.push({ x0: x, y0: y, z0: z, x1: nx, y1: ny, z1: nz, gm, arc, ii, jj, f, kind: knd, lineNo: idx + 1 });
          x = nx; y = ny; z = nz;
        }
      });
      lastBounds = isFinite(minX) ? { minX, minY, maxX, maxY } : null;
      simSegs = segs;
      simIdx = segs.length;
      const sl = $('sim-slider');
      if (sl) { sl.max = Math.max(1, segs.length); sl.value = segs.length; }
      const ro = $('sim-readout');
      if (ro) ro.textContent = 'Кадр: ' + segs.length + '/' + segs.length;
      return { rapid, g, first };
    }

    function stopSim(resetToEnd) {
      simPlaying = false;
      if (simRaf) cancelAnimationFrame(simRaf);
      const btn = $('btn-sim-play');
      if (btn) btn.textContent = '▶ Симуляция';
      if (resetToEnd) {
        simIdx = simSegs.length;
        const sl = $('sim-slider'); if (sl) sl.value = simIdx;
        const ro = $('sim-readout'); if (ro) ro.textContent = 'Кадр: ' + simIdx + '/' + simSegs.length;
      }
      renderViz();
      rebuild3DScene();
    }

    function drawVisualizer(lines, kinds, org, keepView) {
      stopSim(false);
      viz = parseViz(lines, kinds); viz.org = org || { ox: 0, oy: 0 };
      if (!keepView) view = { z: 1, tx: 0, ty: 0 };
      renderViz();
    }

    function renderViz() {
      const dpr = window.devicePixelRatio || 1, host = canvas.parentElement;
      const cw = host.clientWidth || 600, ch = host.clientHeight || 540;
      if (canvas.width !== Math.round(cw * dpr) || canvas.height !== Math.round(ch * dpr)) { canvas.width = Math.round(cw * dpr); canvas.height = Math.round(ch * dpr); }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, cw, ch);
      const W = parseFloat(paramWidth.value) || 300, H = parseFloat(paramHeight.value) || 200, D = parseFloat(paramTool.value) || 0;
      let ox, oy;
      if (viz) { ox = viz.org.ox; oy = viz.org.oy; } else { const o = getOrigin(); ox = o.fx * W; oy = o.fy * H; }
      const m = 35, s = Math.min((cw - m * 2) / W, (ch - m * 2) / H) * view.z;
      const c0x = W / 2 - ox, c0y = H / 2 - oy, cx = cw / 2 + view.tx, cy = ch / 2 + view.ty;
      const X = (x) => cx + (x - c0x) * s, Y = (y) => cy - (y - c0y) * s;
      vp = { s, cx, cy, c0x, c0y };
      const xmin = c0x - cx / s, xmax = c0x + (cw - cx) / s, ymin = c0y - (ch - cy) / s, ymax = c0y + cy / s;
      const NICE = [0.5, 1, 2, 5, 10, 20, 50, 100, 200, 500, 1000, 2000, 5000];
      const minor = NICE.find(v => v * s >= 9) || 5000, major = String(minor)[0] === '2' ? minor * 5 : minor * 10;
      const isMaj = (v) => Math.abs(v / major - Math.round(v / major)) < 1e-6;
      ctx.lineWidth = 1;
      for (let i = Math.ceil(xmin / minor); i * minor <= xmax; i++) { const v = i * minor, p = Math.round(X(v)) + 0.5; ctx.strokeStyle = isMaj(v) ? '#2a2a2a' : '#151515'; ctx.beginPath(); ctx.moveTo(p, 0); ctx.lineTo(p, ch); ctx.stroke(); }
      for (let i = Math.ceil(ymin / minor); i * minor <= ymax; i++) { const v = i * minor, p = Math.round(Y(v)) + 0.5; ctx.strokeStyle = isMaj(v) ? '#2a2a2a' : '#151515'; ctx.beginPath(); ctx.moveTo(0, p); ctx.lineTo(cw, p); ctx.stroke(); }
      ctx.strokeStyle = '#4c1d1d'; ctx.beginPath(); ctx.moveTo(Math.round(X(0)) + 0.5, 0); ctx.lineTo(Math.round(X(0)) + 0.5, ch); ctx.moveTo(0, Math.round(Y(0)) + 0.5); ctx.lineTo(cw, Math.round(Y(0)) + 0.5); ctx.stroke();
      ctx.fillStyle = 'rgba(183,161,123,0.07)'; ctx.fillRect(X(-ox), Y(H - oy), W * s, H * s);
      ctx.strokeStyle = '#FBBF24'; ctx.setLineDash([6, 4]); ctx.strokeRect(X(-ox), Y(H - oy), W * s, H * s); ctx.setLineDash([]);
      if (viz) {
        ctx.save();
        ctx.setTransform(dpr * s, 0, 0, -dpr * s, dpr * (cx - c0x * s), dpr * (cy + c0y * s));
        ctx.lineJoin = 'round'; ctx.lineCap = 'round';
        ctx.lineWidth = 1 / s; ctx.strokeStyle = '#525252'; ctx.stroke(viz.rapid);
        ctx.lineWidth = 1.4 / s; ctx.strokeStyle = '#38BDF8'; ctx.stroke(viz.g.in);
        ctx.strokeStyle = '#FBBF24'; ctx.stroke(viz.g.out);
        ctx.lineWidth = 2.4 / s; ctx.strokeStyle = '#FB923C'; ctx.stroke(viz.g.tab);
        if (simSegs.length > 0 && simIdx < simSegs.length) {
          const donePath = new Path2D();
          for (let i = 0; i < simIdx; i++) {
            const sg = simSegs[i];
            if (sg.gm === 1 && (sg.x0 !== sg.x1 || sg.y0 !== sg.y1)) {
              donePath.moveTo(sg.x0, sg.y0);
              donePath.lineTo(sg.x1, sg.y1);
            }
          }
          ctx.lineWidth = 2.4 / s; ctx.strokeStyle = '#10B981'; ctx.stroke(donePath);
          const cur = simSegs[Math.max(0, simIdx - 1)];
          if (cur) {
            ctx.beginPath(); ctx.arc(cur.x1, cur.y1, Math.max(D / 2, 1.5), 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(239, 68, 68, 0.45)'; ctx.fill();
          }
        }
        ctx.restore();
      }
      ctx.fillStyle = 'rgba(0,0,0,0.8)'; ctx.fillRect(0, ch - 14, cw, 14); ctx.fillRect(0, 0, 32, ch - 14);
      ctx.fillStyle = '#8a8a8a'; ctx.font = '9px "Fira Code", monospace'; ctx.textAlign = 'left';
      for (let i = Math.ceil(xmin / major); i * major <= xmax; i++) { const v = i * major; ctx.fillText(String(Math.round(v * 100) / 100), X(v) + 2, ch - 4); }
      for (let i = Math.ceil(ymin / major); i * major <= ymax; i++) { const v = i * major; if (Y(v) < ch - 16) ctx.fillText(String(Math.round(v * 100) / 100), 2, Y(v) - 2); }
      const mx = X(0), my = Y(0);
      ctx.strokeStyle = '#ef4444'; ctx.fillStyle = '#ef4444'; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(mx - 12, my); ctx.lineTo(mx + 12, my); ctx.moveTo(mx, my - 12); ctx.lineTo(mx, my + 12); ctx.stroke();
      ctx.beginPath(); ctx.arc(mx, my, 4.5, 0, Math.PI * 2); ctx.stroke();
      ctx.font = '10px "Fira Code", monospace'; ctx.fillText('X0 Y0', mx + 8, my - 8);
      canvasInfo.textContent = 'Заготовка: ' + W + '×' + H + ' мм | Фреза Ø' + D + ' | ' + (MODE_NAMES[paramMode.value] || '');
    }

    function resetView() { view = { z: 1, tx: 0, ty: 0 }; renderViz(); }
    function zoomAt(mx, my, r) {
      const nz = Math.min(200, Math.max(0.2, view.z * r)); r = nz / view.z;
      const host = canvas.parentElement, cw = host.clientWidth, ch = host.clientHeight;
      view.tx = mx - cw / 2 - (mx - cw / 2 - view.tx) * r;
      view.ty = my - ch / 2 - (my - ch / 2 - view.ty) * r;
      view.z = nz; renderViz();
    }
    const ptrs = new Map();
    canvas.addEventListener('pointerdown', (e) => { canvas.setPointerCapture(e.pointerId); ptrs.set(e.pointerId, [e.clientX, e.clientY]); });
    canvas.addEventListener('pointermove', (e) => {
      const rc = canvas.getBoundingClientRect();
      if (ptrs.has(e.pointerId)) {
        const prev = ptrs.get(e.pointerId); ptrs.set(e.pointerId, [e.clientX, e.clientY]);
        if (ptrs.size === 1) { view.tx += e.clientX - prev[0]; view.ty += e.clientY - prev[1]; renderViz(); }
      }
      if (vp && canvasXY) { const wx = vp.c0x + (e.clientX - rc.left - vp.cx) / vp.s, wy = vp.c0y + (vp.cy - (e.clientY - rc.top)) / vp.s; canvasXY.textContent = 'X ' + wx.toFixed(1) + '  Y ' + wy.toFixed(1) + ' мм'; }
    });
    const endPtr = (e) => ptrs.delete(e.pointerId);
    canvas.addEventListener('pointerup', endPtr); canvas.addEventListener('pointercancel', endPtr);
    canvas.addEventListener('wheel', (e) => { e.preventDefault(); const rc = canvas.getBoundingClientRect(); zoomAt(e.clientX - rc.left, e.clientY - rc.top, Math.exp(-e.deltaY * 0.0015)); }, { passive: false });
    canvas.addEventListener('dblclick', resetView);
    $('btn-view-reset').addEventListener('click', resetView);

    function tickSim() {
      if (!simPlaying) return;
      const spd = parseInt($('sim-speed').value) || 10;
      simIdx = Math.min(simSegs.length, simIdx + spd);
      $('sim-slider').value = simIdx;
      const cur = simSegs[Math.max(0, simIdx - 1)];
      $('sim-readout').textContent = cur
        ? `Кадр ${cur.lineNo}/${simSegs.length} · X${cur.x1.toFixed(1)} Y${cur.y1.toFixed(1)} Z${cur.z1.toFixed(1)}`
        : `Кадр ${simIdx}/${simSegs.length}`;
      renderViz();
      rebuild3DScene();
      if (simIdx >= simSegs.length) stopSim(false);
      else simRaf = requestAnimationFrame(tickSim);
    }
    $('btn-sim-play').addEventListener('click', () => {
      if (!simSegs.length) return;
      if (simPlaying) stopSim(false);
      else {
        if (simIdx >= simSegs.length) simIdx = 0;
        simPlaying = true;
        $('btn-sim-play').textContent = '⏸ Пауза';
        simRaf = requestAnimationFrame(tickSim);
      }
    });
    $('btn-sim-stop').addEventListener('click', () => stopSim(true));
    $('sim-slider').addEventListener('input', (e) => {
      simPlaying = false;
      $('btn-sim-play').textContent = '▶ Симуляция';
      simIdx = parseInt(e.target.value) || 0;
      const cur = simSegs[Math.max(0, simIdx - 1)];
      $('sim-readout').textContent = cur
        ? `Кадр ${cur.lineNo}/${simSegs.length} · X${cur.x1.toFixed(1)} Y${cur.y1.toFixed(1)} Z${cur.z1.toFixed(1)}`
        : `Кадр ${simIdx}/${simSegs.length}`;
      renderViz();
      rebuild3DScene();
    });

    // ===================== ВКЛАДКИ ПРАВОЙ ПАНЕЛИ (3D / 2D / КОД) =====================
    const tab3d = $('tab-btn-3d'), tabVis = $('tab-btn-vis'), tabCode = $('tab-btn-code');
    const view3d = $('view-3d'), viewVis = $('view-vis'), viewCode = $('view-code');
    function switchRightTab(activeBtn, activeView) {
      [tab3d, tabVis, tabCode].forEach(b => {
        b.className = b === activeBtn
          ? 'px-3.5 py-1.5 rounded-lg text-xs font-bold transition border border-amber-400/50 bg-amber-400/10 text-amber-400 flex items-center gap-1.5'
          : 'px-3.5 py-1.5 rounded-lg text-xs font-bold transition border border-transparent text-neutral-400 hover:text-white flex items-center gap-1.5';
      });
      [view3d, viewVis, viewCode].forEach(v => {
        if (v === activeView) { v.classList.remove('hidden'); v.classList.add('flex'); }
        else { v.classList.add('hidden'); v.classList.remove('flex'); }
      });
      if (activeView === view3d) { resize3D(); rebuild3DScene(); }
      if (activeView === viewVis) renderViz();
    }
    tab3d.addEventListener('click', () => switchRightTab(tab3d, view3d));
    tabVis.addEventListener('click', () => switchRightTab(tabVis, viewVis));
    tabCode.addEventListener('click', () => switchRightTab(tabCode, viewCode));

    // ===================== КНОПКИ ГЕНЕРАЦИИ, ЭКСПОРТА И СОХРАНЕНИЯ =====================
    $('btn-process-main').addEventListener('click', () => { if (loadedImage) generateTapFromImage(); else generateTapFromText(); });
    $('btn-top-generate').addEventListener('click', () => { if (loadedImage) generateTapFromImage(); else generateTapFromText(); });

    function downloadFile(fromVoice) {
      const text = outputArea.value;
      if (!text) { voiceSay('Нет кода для скачивания'); if (fromVoice !== true) alert('Нет сгенерированного кода для скачивания!'); return; }
      const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = (sourceBase ? sourceBase + '_3D_talas' : 'Talas_profi_3D_' + Date.now()) + exportExt.value;
      link.click();
      URL.revokeObjectURL(link.href);
      voiceSay('Файл скачан');
    }
    $('btn-top-download').addEventListener('click', downloadFile);
    $('btn-bottom-download').addEventListener('click', downloadFile);
    $('btn-copy-code').addEventListener('click', () => { if (!outputArea.value) return; navigator.clipboard.writeText(outputArea.value); alert('Код скопирован!'); });
    $('btn-clear-in').addEventListener('click', () => {
      inputArea.value = ''; outputArea.value = ''; loadedImage = null; loadedRawText = null; lastHeightField = null; sourceBase = ''; fileInput.value = '';
      camLog.className = 'hidden'; simSegs = []; simIdx = 0; renderImagePreview(); renderViz(); rebuild3DScene();
    });

    $('btn-frame-tap').addEventListener('click', () => {
      if (!lastBounds) { alert('Сначала сгенерируйте траекторию или загрузите файл!'); return; }
      const sep = chkTabs.checked ? '\t' : ' ', safeZ = parseFloat(paramSafeZ.value) || 5.0, feed = parseFloat(paramFeed.value) || 1200, f3 = q => q.toFixed(3), b = lastBounds;
      const frameLines = ['G90', 'G0' + sep + 'Z' + f3(safeZ), 'G0' + sep + 'X' + f3(b.minX) + sep + 'Y' + f3(b.minY), 'G1' + sep + 'X' + f3(b.maxX) + sep + 'Y' + f3(b.minY) + sep + 'F' + feed, 'G1' + sep + 'X' + f3(b.maxX) + sep + 'Y' + f3(b.maxY), 'G1' + sep + 'X' + f3(b.minX) + sep + 'Y' + f3(b.maxY), 'G1' + sep + 'X' + f3(b.minX) + sep + 'Y' + f3(b.minY), 'G0' + sep + 'X0.000' + sep + 'Y0.000', 'M30'];
      const blob = new Blob([frameLines.join('\r\n')], { type: 'text/plain;charset=utf-8' });
      const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = (sourceBase ? sourceBase + '_FRAME' : 'Talas_profi_FRAME') + exportExt.value; a.click(); URL.revokeObjectURL(a.href);
    });

    const LS_SETTINGS_KEY = 'talas_profi_v6_3d_settings';
    const LS_PRESETS_KEY = 'talas_profi_v6_3d_presets';
    const PERSIST_IDS = ['param-width', 'param-height', 'param-thickness', 'param-feed', 'param-plunge', 'param-safez', 'param-spindle', 'param-step', 'param-rapid', 'param-tool', 'param-tool-type', 'param-vangle', 'param-allowance', 'param-res-x', 'param-mode', 'param-smooth', 'param-cutz', 'param-passes', 'export-ext'];
    const PERSIST_CHKS = ['chk-trim-bounds', 'chk-skip-top', 'chk-holdtabs', 'chk-ramp', 'chk-arcs', 'chk-fill', 'chk-dogbone', 'chk-tabs', 'chk-m30', 'chk-m5', 'chk-header', 'chk-return-zero'];

    function saveSettingsToLS() {
      try {
        const data = { vals: {}, chks: {} };
        PERSIST_IDS.forEach(id => { const el = $(id); if (el) data.vals[id] = el.value; });
        PERSIST_CHKS.forEach(id => { const el = $(id); if (el) data.chks[id] = el.checked; });
        const org = document.querySelector('input[name="origin"]:checked');
        if (org) data.origin = org.value;
        localStorage.setItem(LS_SETTINGS_KEY, JSON.stringify(data));
      } catch (e) {}
    }
    function loadSettingsFromLS() {
      try {
        const raw = localStorage.getItem(LS_SETTINGS_KEY);
        if (!raw) return;
        const data = JSON.parse(raw);
        if (data.vals) Object.entries(data.vals).forEach(([id, v]) => { const el = $(id); if (el && v !== undefined) el.value = v; });
        if (data.chks) Object.entries(data.chks).forEach(([id, v]) => { const el = $(id); if (el) el.checked = !!v; });
        if (data.origin) { const r = document.querySelector('input[name="origin"][value="' + data.origin + '"]'); if (r) r.checked = true; }
        smoothSlider.dispatchEvent(new Event('input'));
      } catch (e) {}
    }
    function renderCustomPresets() {
      const wrap = $('custom-presets-wrap'); if (!wrap) return; wrap.innerHTML = '';
      let list = []; try { list = JSON.parse(localStorage.getItem(LS_PRESETS_KEY) || '[]'); } catch (e) {}
      list.forEach((pr, idx) => {
        const grp = document.createElement('div');
        grp.className = 'inline-flex items-center rounded bg-neutral-900 border border-neutral-700 overflow-hidden shrink-0';
        const btn = document.createElement('button');
        btn.type = 'button'; btn.className = 'px-2 py-1 hover:bg-amber-400 hover:text-black text-amber-300 text-[10px] font-medium transition'; btn.textContent = pr.name;
        btn.addEventListener('click', () => {
          paramCutZ.value = pr.cutz; paramPasses.value = pr.passes; paramFeed.value = pr.feed;
          $('param-plunge').value = pr.plunge; paramTool.value = pr.tool; $('param-spindle').value = pr.spindle;
          if (pr.mode) paramMode.value = pr.mode;
          depthTouched = false; distributeDepth(); renderDepthFields(); updateOpenRow(); saveSettingsToLS();
          if (loadedImage) generateTapFromImage();
        });
        const del = document.createElement('button');
        del.type = 'button'; del.className = 'px-1 py-1 text-neutral-500 hover:text-red-400 text-[10px]'; del.textContent = '×';
        del.addEventListener('click', () => { list.splice(idx, 1); localStorage.setItem(LS_PRESETS_KEY, JSON.stringify(list)); renderCustomPresets(); });
        grp.appendChild(btn); grp.appendChild(del); wrap.appendChild(grp);
      });
    }
    $('btn-save-preset').addEventListener('click', () => {
      const name = prompt('Название нового 3D-пресета:'); if (!name || !name.trim()) return;
      let list = []; try { list = JSON.parse(localStorage.getItem(LS_PRESETS_KEY) || '[]'); } catch (e) {}
      list.push({ name: name.trim(), mode: paramMode.value, cutz: parseFloat(paramCutZ.value) || -6, passes: parseInt(paramPasses.value) || 3, feed: parseFloat(paramFeed.value) || 1800, plunge: parseFloat($('param-plunge').value) || 400, tool: parseFloat(paramTool.value) || 3, spindle: parseFloat($('param-spindle').value) || 14000 });
      localStorage.setItem(LS_PRESETS_KEY, JSON.stringify(list)); renderCustomPresets();
    });
    $('btn-reset-settings').addEventListener('click', () => { if (confirm('Сбросить все настройки?')) { localStorage.removeItem(LS_SETTINGS_KEY); location.reload(); } });

    [...PERSIST_IDS, ...PERSIST_CHKS].forEach(id => { const el = $(id); if (el) { el.addEventListener('change', saveSettingsToLS); el.addEventListener('input', saveSettingsToLS); } });
    document.querySelectorAll('input[name="origin"]').forEach(r => r.addEventListener('change', saveSettingsToLS));

    const thrEl = $('preview-threshold'), invEl = $('preview-invert');
    thrEl.addEventListener('input', () => { $('threshold-val').textContent = thrEl.value; renderImagePreview(); });
    [thrEl, invEl].forEach(el => el.addEventListener('change', () => { renderImagePreview(); if (loadedImage) generateTapFromImage(); }));

    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('border-amber-400'); });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('border-amber-400'));
    dropZone.addEventListener('drop', (e) => { e.preventDefault(); dropZone.classList.remove('border-amber-400'); if (e.dataTransfer.files.length) { fileInput.files = e.dataTransfer.files; fileInput.dispatchEvent(new Event('change')); } });

    // ===================== ГОЛОСОВОЙ ПОМОЩНИК =====================
    const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
    const voiceBtn = $('btn-voice'), voiceDot = $('voice-dot'), voiceState = $('voice-state'), voiceText = $('voice-text');
    let voiceOn = false, recog = null, speakBusy = 0, voiceTimer = null, ruVoice = null;
    const VSTATES = { off: ['#ef4444', 'Выкл'], listen: ['#FBBF24', 'Слушаю'], ok: ['#22c55e', 'Принято'] };
    function setVoiceState(st) { voiceDot.style.setProperty('--c', VSTATES[st][0]); voiceState.textContent = VSTATES[st][1]; voiceBtn.classList.toggle('border-amber-400/60', st !== 'off'); }
    function pickRu() { ruVoice = ('speechSynthesis' in window ? speechSynthesis.getVoices() : []).find(v => /^ru/i.test(v.lang)) || null; }
    if ('speechSynthesis' in window) { pickRu(); speechSynthesis.onvoiceschanged = pickRu; }
    function voiceSay(text) {
      if (!voiceOn || !('speechSynthesis' in window)) return;
      const u = new SpeechSynthesisUtterance(text); u.lang = 'ru-RU'; u.rate = 1.02; if (ruVoice) u.voice = ruVoice;
      speakBusy++; try { recog && recog.stop(); } catch (e) {}
      const done = () => { speakBusy = Math.max(0, speakBusy - 1); if (voiceOn && !speakBusy) startRecog(); };
      u.onend = done; u.onerror = done; speechSynthesis.speak(u);
    }
    function startRecog() { if (!recog || !voiceOn || speakBusy) return; try { recog.start(); } catch (e) {} setVoiceState('listen'); }
    if (SR) {
      recog = new SR(); recog.lang = 'ru-RU'; recog.continuous = true; recog.interimResults = false;
      recog.onresult = (e) => { for (let i = e.resultIndex; i < e.results.length; i++) if (e.results[i].isFinal) handleVoice(e.results[i][0].transcript); };
      recog.onend = () => { if (voiceOn && !speakBusy) setTimeout(startRecog, 300); };
    }
    voiceBtn.addEventListener('click', () => {
      if (voiceOn) { voiceOn = false; speakBusy = 0; try { recog && recog.abort(); } catch (e) {} setVoiceState('off'); voiceText.textContent = ''; }
      else if (SR) { voiceOn = true; startRecog(); voiceSay('Голос включён'); }
    });
    setVoiceState('off');
    function handleVoice(raw) {
      const tx = raw.toLowerCase().replace(/ё/g, 'е').trim(); if (!tx) return;
      setVoiceState('ok'); voiceText.textContent = '🎙 «' + tx + '»';
      clearTimeout(voiceTimer); voiceTimer = setTimeout(() => { if (voiceOn) setVoiceState('listen'); }, 1400);
      if (/скача|сохран/.test(tx)) return downloadFile(true);
      if (/сброс|центр/.test(tx)) { set3DViewPreset('iso'); resetView(); return voiceSay('Вид сброшен'); }
      if (/сгенер|старт|рассчит/.test(tx)) { if (loadedImage) generateTapFromImage(); else generateTapFromText(); }
    }

    // Старт
    loadSettingsFromLS();
    renderCustomPresets();
    renderImagePreview();
    distributeDepth();
    renderDepthFields();
    updateOpenRow();
    updateOriginCaption();
    renderViz();
    init3D();
  </script>
</body>
</html>
