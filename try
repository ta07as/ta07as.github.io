<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Talas_profi — CNC 3D Relief & G-Code to .TAP Master v6.0</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap');
    body { font-family: 'Inter', sans-serif; background-color: #050505; color: #f5f5f5; }
    .code-font { font-family: 'Fira Code', monospace; }
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: #0a0a0a; }
    ::-webkit-scrollbar-thumb { background: #262626; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #FBBF24; }
    canvas { background-color: #000000; }
    #cnc-canvas, #cnc-3d-wrap { touch-action: none; cursor: grab; }
    .vdot { position: relative; width: 9px; height: 9px; border-radius: 50%; background: var(--c, #ef4444); flex-shrink: 0; }
    .vdot::after { content: ''; position: absolute; inset: 0; border-radius: 50%; background: var(--c, #ef4444); animation: vping 1.4s ease-out infinite; }
    @keyframes vping { 0% { transform: scale(1); opacity: .7; } 100% { transform: scale(2.8); opacity: 0; } }
    input[type="number"], select { padding-top: 0.36rem; padding-bottom: 0.36rem; }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-amber-400 selection:text-black text-xs">

  <!-- Шапка -->
  <header class="border-b border-neutral-800 bg-neutral-950/95 backdrop-blur sticky top-0 z-50 px-4 py-2.5 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-2.5">
      <div class="bg-amber-400 text-black px-2.5 py-1.5 rounded-lg font-black text-base shadow-md shadow-amber-400/20">⚡</div>
      <div>
        <h1 class="text-sm md:text-base font-bold tracking-tight text-white flex items-center gap-2">
          Talas_profi <span class="text-amber-400 font-mono text-[11px] px-1.5 py-0.5 bg-amber-400/10 border border-amber-400/30 rounded">CNC 3D .TAP Master v6.0</span>
        </h1>
        <p class="text-[10px] text-neutral-400 hidden sm:block">3D Рельеф • Вывески и буквы • Черновой + Чистовой 3D • Inectra / GRBL / NCStudio</p>
      </div>
    </div>

    <!-- Быстрые пресеты -->
    <div class="hidden xl:flex items-center gap-1.5 bg-black/60 border border-neutral-800 px-2.5 py-1 rounded-lg max-w-[580px] overflow-x-auto">
      <span class="text-[10px] text-neutral-500 mr-1 shrink-0">Пресет:</span>
      <button type="button" data-preset="relief3d" class="preset-btn shrink-0 px-2 py-1 rounded bg-amber-400/15 border border-amber-400/40 hover:bg-amber-400 hover:text-black text-amber-300 text-[10px] font-bold transition">🏔 3D Рельеф 8мм</button>
      <button type="button" data-preset="sign3d" class="preset-btn shrink-0 px-2 py-1 rounded bg-neutral-900 hover:bg-amber-400 hover:text-black text-neutral-300 text-[10px] font-medium transition">🪧 Вывеска 5мм</button>
      <button type="button" data-preset="plywood4" class="preset-btn shrink-0 px-2 py-1 rounded bg-neutral-900 hover:bg-amber-400 hover:text-black text-neutral-300 text-[10px] font-medium transition">Фанера 4мм</button>
      <button type="button" data-preset="mdf16" class="preset-btn shrink-0 px-2 py-1 rounded bg-neutral-900 hover:bg-amber-400 hover:text-black text-neutral-300 text-[10px] font-medium transition">МДФ 16мм</button>
      <button type="button" data-preset="hardwood" class="preset-btn shrink-0 px-2 py-1 rounded bg-neutral-900 hover:bg-amber-400 hover:text-black text-neutral-300 text-[10px] font-medium transition">Бук / Дуб</button>
      <div id="custom-presets-wrap" class="flex items-center gap-1"></div>
      <button type="button" id="btn-save-preset" title="Сохранить текущие параметры как пресет" class="shrink-0 px-2 py-1 rounded bg-amber-400/15 hover:bg-amber-400 hover:text-black text-amber-300 border border-amber-400/40 text-[10px] font-bold transition">+ Пресет</button>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <span id="voice-text" class="hidden 2xl:block max-w-[200px] truncate text-[10px] text-neutral-500 code-font"></span>
      <button id="btn-voice" type="button" title="Голосовые команды: «сгенерировать», «скачать», «очистить», «сбросить вид»" class="bg-neutral-900 hover:bg-neutral-800 text-neutral-200 border border-neutral-700 font-semibold px-3 py-1.5 rounded-lg text-xs transition active:scale-95 flex items-center gap-2">
        <span id="voice-dot" class="vdot" style="--c:#ef4444"></span>
        <span>🎙️ Голос</span>
        <span id="voice-state" class="code-font text-[10px] uppercase text-neutral-500">Выкл</span>
      </button>
      <button id="btn-top-generate" class="bg-amber-400 hover:bg-amber-300 text-black font-bold px-4 py-1.5 rounded-lg text-xs transition-all shadow-md shadow-amber-400/20 active:scale-95 flex items-center gap-1.5">
        🚀 Сгенерировать 3D .TAP
      </button>
      <button id="btn-top-download" class="bg-neutral-900 hover:bg-neutral-800 text-amber-400 border border-amber-400/40 font-semibold px-3 py-1.5 rounded-lg text-xs transition active:scale-95 flex items-center gap-1.5">
        💾 Скачать
      </button>
    </div>
  </header>

  <!-- Основной контент -->
  <main class="flex-1 grid grid-cols-1 lg:grid-cols-12 gap-4 p-3 md:p-4 max-w-[1920px] mx-auto w-full">
    
    <!-- Левая панель управления (4 колонки) -->
    <div class="lg:col-span-4 flex flex-col gap-3">
      
      <!-- 1. Загрузка файла + мини-предпросмотр -->
      <div class="bg-neutral-900/90 border border-neutral-800 rounded-xl p-3.5 shadow-xl">
        <div class="grid grid-cols-12 gap-3 items-center">
          <div id="drop-zone" class="col-span-5 border-2 border-dashed border-neutral-700 hover:border-amber-400 bg-neutral-950 rounded-lg p-3 text-center cursor-pointer transition flex flex-col items-center justify-center gap-1 h-[156px] group">
            <div class="text-2xl text-neutral-500 group-hover:text-amber-400 transition-colors">🏔️</div>
            <p class="text-[11px] text-neutral-200 font-medium leading-tight">Загрузить фото / карту</p>
            <p class="text-[9px] text-neutral-500 leading-tight">PNG, JPG, SVG, .TAP, .NC</p>
            <input type="file" id="file-input" class="hidden" accept=".png,.jpg,.jpeg,.webp,.svg,.tap,.nc,.gcode,.txt">
          </div>
          <div class="col-span-7 flex flex-col gap-1">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-bold text-neutral-400 uppercase">Позиция на столе</span>
              <span id="preview-status" class="text-[10px] text-amber-400 font-mono truncate max-w-[140px]">Ожидает файл</span>
            </div>
            <div class="rounded-lg overflow-hidden border border-neutral-800 bg-black">
              <canvas id="image-preview" class="block w-full" style="height:136px;background:#080808;"></canvas>
            </div>
          </div>
        </div>
        <div id="preview-warning" class="hidden mt-2 text-[10px] text-amber-300 bg-amber-400/10 border border-amber-400/30 rounded px-2.5 py-1.5"></div>
      </div>

      <!-- 2. Вкладки настроек -->
      <div class="bg-neutral-900/90 border border-neutral-800 rounded-xl p-3.5 shadow-xl flex flex-col gap-3 flex-1">
        
        <div class="grid grid-cols-4 gap-1 bg-black p-1 rounded-lg border border-neutral-800">
          <button type="button" data-stab="size" class="stab-btn py-1.5 px-1 rounded text-[11px] font-bold bg-amber-400 text-black transition">📐 Размеры</button>
          <button type="button" data-stab="stock" class="stab-btn py-1.5 px-1 rounded text-[11px] font-semibold text-neutral-400 hover:text-white transition">🪵 Стол / 0</button>
          <button type="button" data-stab="mill" class="stab-btn py-1.5 px-1 rounded text-[11px] font-semibold text-neutral-400 hover:text-white transition">🛠 3D Фреза</button>
          <button type="button" data-stab="depth" class="stab-btn py-1.5 px-1 rounded text-[11px] font-semibold text-neutral-400 hover:text-white transition">⏬ Глубина</button>
        </div>

        <!-- ВКЛАДКА 1: РАЗМЕРЫ И КАРТА ВЫСОТ -->
        <div id="stab-size" class="stab-panel flex flex-col gap-2.5">
          <label class="flex items-center gap-2 text-[11px] text-amber-300 font-medium cursor-pointer bg-amber-400/10 border border-amber-400/30 px-2.5 py-1.5 rounded-lg">
            <input type="checkbox" id="chk-trim-bounds" checked class="accent-amber-400 rounded">
            Авто-обрезка пустых полей (размер строго по объекту)
          </label>
          <div id="svg-mode-box" class="hidden flex items-center justify-between gap-2 bg-emerald-500/10 border border-emerald-500/30 px-2.5 py-1.5 rounded-lg text-[11px]">
            <span class="text-emerald-300 font-semibold">📐 Режим SVG:</span>
            <select id="param-svg-mode" class="bg-black border border-emerald-500/40 text-emerald-300 text-[11px] rounded px-2 py-0.5 font-mono">
              <option value="vector" selected>Вектор напрямую (для 2.5D)</option>
              <option value="raster">Через растр (для 3D рельефа)</option>
            </select>
          </div>

          <div class="grid grid-cols-2 gap-2.5">
            <label class="text-[11px] text-neutral-300 font-semibold">Ширина объекта (мм)
              <input id="object-width" type="number" step="0.5" min="0.1" value="" placeholder="Напр. 250" class="mt-1 w-full bg-black border border-amber-400/50 text-amber-400 text-xs rounded-lg px-2.5 font-mono focus:outline-none focus:border-amber-400">
            </label>
            <label class="text-[11px] text-neutral-300 font-semibold">Высота объекта (мм)
              <input id="object-height" type="number" step="0.5" min="0.1" value="" placeholder="Напр. 150" class="mt-1 w-full bg-black border border-amber-400/50 text-amber-400 text-xs rounded-lg px-2.5 font-mono focus:outline-none focus:border-amber-400">
            </label>
            <label class="text-[11px] text-neutral-400">Масштаб (%) если мм пусто
              <input id="preview-scale" type="number" min="1" max="500" value="85" class="mt-1 w-full bg-black border border-neutral-700 text-amber-400 text-xs rounded-lg px-2.5 font-mono">
            </label>
            <label class="text-[11px] text-neutral-400">Поворот (°)
              <input id="preview-rotation" type="number" min="-180" max="180" value="0" class="mt-1 w-full bg-black border border-neutral-700 text-amber-400 text-xs rounded-lg px-2.5 font-mono">
            </label>
            <label class="text-[11px] text-neutral-400">Смещение X (мм)
              <input id="preview-x" type="number" step="1" value="0" class="mt-1 w-full bg-black border border-neutral-700 text-amber-400 text-xs rounded-lg px-2.5 font-mono">
            </label>
            <label class="text-[11px] text-neutral-400">Смещение Y (мм)
              <input id="preview-y" type="number" step="1" value="0" class="mt-1 w-full bg-black border border-neutral-700 text-amber-400 text-xs rounded-lg px-2.5 font-mono">
            </label>
          </div>

          <div class="p-2.5 rounded-lg border border-neutral-800 bg-black/50 flex flex-col gap-1.5">
            <div class="flex items-center justify-between text-[11px] text-neutral-400">
              <span>Порог яркости (для 2.5D контуров):</span>
              <span id="threshold-val" class="text-amber-400 font-mono">130</span>
            </div>
            <input id="preview-threshold" type="range" min="20" max="240" value="130" class="w-full accent-amber-400 h-1.5">
            <div class="flex items-center justify-between text-[11px] text-neutral-400 pt-1">
              <span>Сглаживание 3D-рельефа (анти-шум):</span>
              <span id="relief-blur-val" class="text-amber-400 font-mono">2 px</span>
            </div>
            <input id="relief-blur" type="range" min="0" max="10" value="2" class="w-full accent-amber-400 h-1.5">
            <label class="flex items-center gap-2 text-[11px] text-neutral-300 cursor-pointer pt-0.5">
              <input type="checkbox" id="preview-invert" class="accent-amber-400 rounded"> Инвертировать высоты (белое = выпуклое / глубже)
            </label>
          </div>

          <div class="grid grid-cols-2 gap-2">
            <button id="preview-reset" type="button" class="bg-neutral-800 hover:bg-neutral-700 text-white text-xs font-semibold rounded-lg py-1.5">↺ Сбросить</button>
            <button id="preview-center" type="button" class="bg-amber-400/20 hover:bg-amber-400/30 text-amber-300 border border-amber-400/40 text-xs font-bold rounded-lg py-1.5">⊙ По центру</button>
          </div>
        </div>

        <!-- ВКЛАДКА 2: ЗАГОТОВКА, СКОРОСТИ И НУЛЕВАЯ ТОЧКА -->
        <div id="stab-stock" class="stab-panel hidden flex-col gap-2.5">
          <div class="grid grid-cols-2 gap-2.5">
            <label class="text-[11px] text-neutral-400">Ширина заготовки X (мм)
              <input type="number" id="param-width" value="300" class="mt-1 w-full bg-black border border-neutral-700 text-amber-400 text-xs rounded-lg px-2.5 font-mono">
            </label>
            <label class="text-[11px] text-neutral-400">Высота заготовки Y (мм)
              <input type="number" id="param-height" value="200" class="mt-1 w-full bg-black border border-neutral-700 text-amber-400 text-xs rounded-lg px-2.5 font-mono">
            </label>
            <label class="text-[11px] text-neutral-400">Толщина заготовки Z (мм)
              <input type="number" id="param-thickness" value="18" min="1" step="1" class="mt-1 w-full bg-black border border-neutral-700 text-amber-400 text-xs rounded-lg px-2.5 font-mono">
            </label>
            <label class="text-[11px] text-neutral-400">Безопасная Z (мм)
              <input type="number" id="param-safez" value="5.0" step="1" class="mt-1 w-full bg-black border border-neutral-700 text-amber-400 text-xs rounded-lg px-2.5 font-mono">
            </label>
            <label class="text-[11px] text-neutral-400">Рабочая подача F (мм/мин)
              <input type="number" id="param-feed" value="1800" step="100" class="mt-1 w-full bg-black border border-neutral-700 text-amber-400 text-xs rounded-lg px-2.5 font-mono">
            </label>
            <label class="text-[11px] text-neutral-400">Подача врезания (мм/мин)
              <input type="number" id="param-plunge" value="400" step="50" min="1" class="mt-1 w-full bg-black border border-neutral-700 text-amber-400 text-xs rounded-lg px-2.5 font-mono">
            </label>
            <label class="text-[11px] text-neutral-400">Шпиндель (S, об/мин)
              <input type="number" id="param-spindle" value="14000" step="500" min="0" class="mt-1 w-full bg-black border border-neutral-700 text-amber-400 text-xs rounded-lg px-2.5 font-mono">
            </label>
            <label class="text-[11px] text-neutral-400">Холостой ход (для расчёта)
              <input type="number" id="param-rapid" value="3000" step="500" min="100" class="mt-1 w-full bg-black border border-neutral-700 text-amber-400 text-xs rounded-lg px-2.5 font-mono">
            </label>
          </div>

          <div class="pt-2 border-t border-neutral-800 flex items-center gap-3.5">
            <div class="grid grid-cols-3 gap-1 shrink-0">
              <label class="cursor-pointer"><input type="radio" name="origin" value="0,1" class="peer sr-only"><span class="flex items-center justify-center w-8 h-8 rounded border border-neutral-700 bg-black text-neutral-400 text-xs peer-checked:bg-amber-400 peer-checked:text-black peer-checked:font-bold">↖</span></label>
              <label class="cursor-pointer"><input type="radio" name="origin" value="0.5,1" class="peer sr-only"><span class="flex items-center justify-center w-8 h-8 rounded border border-neutral-700 bg-black text-neutral-400 text-xs peer-checked:bg-amber-400 peer-checked:text-black peer-checked:font-bold">↑</span></label>
              <label class="cursor-pointer"><input type="radio" name="origin" value="1,1" class="peer sr-only"><span class="flex items-center justify-center w-8 h-8 rounded border border-neutral-700 bg-black text-neutral-400 text-xs peer-checked:bg-amber-400 peer-checked:text-black peer-checked:font-bold">↗</span></label>
              <label class="cursor-pointer"><input type="radio" name="origin" value="0,0.5" class="peer sr-only"><span class="flex items-center justify-center w-8 h-8 rounded border border-neutral-700 bg-black text-neutral-400 text-xs peer-checked:bg-amber-400 peer-checked:text-black peer-checked:font-bold">←</span></label>
              <label class="cursor-pointer"><input type="radio" name="origin" value="0.5,0.5" class="peer sr-only"><span class="flex items-center justify-center w-8 h-8 rounded border border-neutral-700 bg-black text-neutral-400 text-xs peer-checked:bg-amber-400 peer-checked:text-black peer-checked:font-bold">⊙</span></label>
              <label class="cursor-pointer"><input type="radio" name="origin" value="1,0.5" class="peer sr-only"><span class="flex items-center justify-center w-8 h-8 rounded border border-neutral-700 bg-black text-neutral-400 text-xs peer-checked:bg-amber-400 peer-checked:text-black peer-checked:font-bold">→</span></label>
              <label class="cursor-pointer"><input type="radio" name="origin" value="0,0" class="peer sr-only" checked><span class="flex items-center justify-center w-8 h-8 rounded border border-neutral-700 bg-black text-neutral-400 text-xs peer-checked:bg-amber-400 peer-checked:text-black peer-checked:font-bold">↙</span></label>
              <label class="cursor-pointer"><input type="radio" name="origin" value="0.5,0" class="peer sr-only"><span class="flex items-center justify-center w-8 h-8 rounded border border-neutral-700 bg-black text-neutral-400 text-xs peer-checked:bg-amber-400 peer-checked:text-black peer-checked:font-bold">↓</span></label>
              <label class="cursor-pointer"><input type="radio" name="origin" value="1,0" class="peer sr-only"><span class="flex items-center justify-center w-8 h-8 rounded border border-neutral-700 bg-black text-neutral-400 text-xs peer-checked:bg-amber-400 peer-checked:text-black peer-checked:font-bold">↘</span></label>
            </div>
            <div class="flex flex-col gap-1 flex-1">
              <span class="text-[10px] font-bold text-neutral-400 uppercase">Нулевая точка станка (верх = Z0):</span>
              <div id="origin-caption" class="text-[11px] text-neutral-300 code-font leading-snug"></div>
              <div class="flex flex-wrap gap-1.5 mt-1">
                <button type="button" id="btn-frame-tap" title="Обводка габаритов на безопасной высоте без включения шпинделя" class="bg-neutral-800 hover:bg-amber-400 hover:text-black text-amber-300 border border-amber-400/40 text-[10px] font-semibold px-2 py-1 rounded transition">🔲 Обводка габаритов (.TAP)</button>
                <button type="button" id="btn-reset-settings" title="Сбросить все настройки к заводским" class="bg-neutral-950 hover:bg-red-500/20 text-neutral-400 hover:text-red-300 border border-neutral-800 text-[10px] px-2 py-1 rounded transition">↺ Сброс настроек</button>
              </div>
            </div>
          </div>
        </div>

        <!-- ВКЛАДКА 3: 3D ФРЕЗА И СТРАТЕГИЯ ОБРАБОТКИ -->
        <div id="stab-mill" class="stab-panel hidden flex-col gap-2.5">
          <div class="grid grid-cols-2 gap-2.5">
            <label class="text-[11px] text-neutral-400">Режим / Стратегия ЧПУ
              <select id="param-mode" class="mt-1 w-full bg-black border border-amber-400/50 text-amber-400 text-xs rounded-lg px-2 font-mono">
                <optgroup label="🏔 3D Рельеф и Вывески">
                  <option value="relief_x" selected>🏔 3D Рельеф: Чистовой растр X</option>
                  <option value="relief_y">🏔 3D Рельеф: Чистовой растр Y</option>
                  <option value="relief_rough_fin">🔨 3D Черновой + Чистовой X</option>
                  <option value="sign_emboss">🪧 Вывеска: выборка фона + буквы</option>
                </optgroup>
                <optgroup label="📐 2.5D Контуры и Орнаменты">
                  <option value="letters">🔤 Раскрой букв (Контур + Отверстия)</option>
                  <option value="ornament">🌀 Орнамент: гладкие кривые (Chaikin)</option>
                  <option value="center">3 — По центру линии (Centerline)</option>
                  <option value="lineout">4 — Снаружи линии (Outside)</option>
                  <option value="linein">5 — Внутри линии (Inside)</option>
                  <option value="pocket">1 — Внутренний карман (Pocket)</option>
                  <option value="clear">2 — Очистка снаружи (Clearing)</option>
                </optgroup>
              </select>
            </label>
            <label class="text-[11px] text-neutral-400">Тип фрезы (для 3D-расчёта)
              <select id="param-tool-type" class="mt-1 w-full bg-black border border-neutral-700 text-amber-400 text-xs rounded-lg px-2 font-mono">
                <option value="ball" selected>🔵 Сферическая (Ball-Nose)</option>
                <option value="flat"> цилиндр Концевая прямая (Flat)</option>
                <option value="vbit">🔻 Коническая / Гравёр (V-Bit)</option>
              </select>
            </label>
          </div>

          <div class="grid grid-cols-3 gap-2">
            <label class="text-[10px] text-neutral-400">Диаметр фрезы (мм)
              <input type="number" id="param-tool" value="3" min="0.1" step="0.1" class="mt-1 w-full bg-black border border-neutral-700 text-amber-400 text-xs rounded-lg px-2 font-mono">
            </label>
            <label class="text-[10px] text-neutral-400">Шаг строки / растра (мм)
              <input type="number" id="param-step" value="0.6" min="0.05" step="0.1" class="mt-1 w-full bg-black border border-neutral-700 text-amber-400 text-xs rounded-lg px-2 font-mono">
            </label>
            <label class="text-[10px] text-neutral-400" id="vangle-wrap">Угол V-фрезы (°)
              <input type="number" id="param-vangle" value="30" min="5" max="120" step="5" class="mt-1 w-full bg-black border border-neutral-700 text-amber-400 text-xs rounded-lg px-2 font-mono">
            </label>
          </div>

          <!-- Параметры 3D рельефа -->
          <div id="relief-3d-box" class="p-2.5 rounded-lg border border-amber-400/30 bg-amber-400/5 flex flex-col gap-2">
            <div class="grid grid-cols-2 gap-2">
              <label class="text-[10px] text-neutral-300">Припуск черновой (мм)
