    let loadedImage = null;
    let loadedRawText = null;
    let loadedSvgText = null;
    let sourceBase = '';
    let lastBounds = null;
    let lastHeightField = null; // { grid: Float32Array, cols, rows, W, H, ox, oy, maxDepth }

    // ===================== ВКЛАДКИ ЛЕВОЙ ПАНЕЛИ =====================
    document.querySelectorAll('.stab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.stab;
        document.querySelectorAll('.stab-btn').forEach(b => {
          b.className = b === btn
            ? 'stab-btn py-1.5 px-1 rounded text-[11px] font-bold bg-amber-400 text-black transition'
