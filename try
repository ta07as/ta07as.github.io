        document.querySelectorAll('.stab-panel').forEach(p => {
          if (p.id === 'stab-' + target) { p.classList.remove('hidden'); p.classList.add('flex'); }
          else { p.classList.add('hidden'); p.classList.remove('flex'); }
        });
        if (target === 'size') renderImagePreview();
      });
    });

    // ===================== ПРЕСЕТЫ МАТЕРИАЛОВ =====================
    const PRESETS = {
      relief3d: { mode: 'relief_x', toolType: 'ball', cutz: -8.0, passes: 3, feed: 2400, plunge: 600, tool: 3, step: 0.4, spindle: 16000 },
      sign3d:   { mode: 'sign_emboss', toolType: 'flat', cutz: -5.0, passes: 2, feed: 1800, plunge: 450, tool: 3, step: 1.0, spindle: 14000 },
      plywood4: { mode: 'letters', toolType: 'flat', cutz: -4.2, passes: 2, feed: 1500, plunge: 400, tool: 3, step: 1.5, spindle: 14000 },
      mdf16:    { mode: 'letters', toolType: 'flat', cutz: -16.2, passes: 4, feed: 2200, plunge: 600, tool: 6, step: 2.0, spindle: 16000 },
      hardwood: { mode: 'relief_rough_fin', toolType: 'ball', cutz: -10.0, passes: 4, feed: 1500, plunge: 350, tool: 3, step: 0.5, spindle: 14000 }
    };
    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const p = PRESETS[btn.dataset.preset];
        if (!p) return;
        if (p.mode) paramMode.value = p.mode;
        if (p.toolType) $('param-tool-type').value = p.toolType;
        paramCutZ.value = p.cutz;
        paramPasses.value = p.passes;
        paramFeed.value = p.feed;
        $('param-plunge').value = p.plunge;
        paramTool.value = p.tool;
        if (p.step) paramStep.value = p.step;
        $('param-spindle').value = p.spindle;
        depthTouched = false;
        distributeDepth();
        renderDepthFields();
        updateOpenRow();
        if (loadedImage) generateTapFromImage();
      });
    });

    // ===================== ПРЕДПРОСМОТР НА СТОЛЕ =====================
    const previewCanvas = $('image-preview');
    const previewCtx = previewCanvas.getContext('2d');
    const chkTrimBounds = $('chk-trim-bounds');
    const objWidthInput = $('object-width');
    const objHeightInput = $('object-height');
    const previewScale = $('preview-scale');
    const previewRotation = $('preview-rotation');
    const previewX = $('preview-x');
    const previewY = $('preview-y');
    const previewStatus = $('preview-status');
    const previewWarning = $('preview-warning');

    const getThreshold = () => Math.min(240, Math.max(20, parseInt($('preview-threshold').value) || 130));
    const getReliefBlur = () => Math.min(10, Math.max(0, parseInt($('relief-blur').value) || 0));

    function getContentCropBox(img) {
      if (!chkTrimBounds.checked) {
        return { sx: 0, sy: 0, sw: img.width, sh: img.height };
      }
      const maxDim = 512;
      const scale = Math.min(1, maxDim / Math.max(img.width, img.height));
      const cw = Math.max(1, Math.round(img.width * scale));
      const ch = Math.max(1, Math.round(img.height * scale));
      const tmp = document.createElement('canvas');
      tmp.width = cw; tmp.height = ch;
      const g = tmp.getContext('2d', { willReadFrequently: true });
      const inv = $('preview-invert').checked;
      const thr = getThreshold();
      g.fillStyle = inv ? '#000' : '#fff';
      g.fillRect(0, 0, cw, ch);
      g.drawImage(img, 0, 0, cw, ch);
      const d = g.getImageData(0, 0, cw, ch).data;

      let minX = cw, minY = ch, maxX = -1, maxY = -1;
      for (let y = 0; y < ch; y++) {
        for (let x = 0; x < cw; x++) {
          const idx = (y * cw + x) * 4;
          const lum = (d[idx] + d[idx + 1] + d[idx + 2]) / 3;
          const active = inv ? (lum > thr) : (lum < thr);
          if (active) {
            if (x < minX) minX = x; if (x > maxX) maxX = x;
            if (y < minY) minY = y; if (y > maxY) maxY = y;
          }
        }
      }
      if (maxX < minX || maxY < minY) return { sx: 0, sy: 0, sw: img.width, sh: img.height };
      const pad = 2;
      minX = Math.max(0, minX - pad); minY = Math.max(0, minY - pad);
      maxX = Math.min(cw - 1, maxX + pad); maxY = Math.min(ch - 1, maxY + pad);
      return {
